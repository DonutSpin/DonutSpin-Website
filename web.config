<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for hosts that run Node.js behind HttpPlatformHandler
  (MonsterASP, Plesk on Windows, plain IIS).

  Without this file IIS only serves static files, so the SPA renders but every
  /api request returns an IIS 404 and the UI shows "The server is not answering".

  HTTP_PLATFORM_PORT is assigned by IIS; it is mapped to PORT here so the app
  listens on the port IIS forwards to.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>

    <httpPlatform processPath="node"
                  arguments="--import tsx server/index.ts"
                  startupTimeLimit="120"
                  startupRetryCount="10"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>

    <!-- Defence in depth: these folders are never meant to be downloadable. -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="server" />
          <add segment="shared" />
          <add segment="src" />
          <add segment="tests" />
          <add segment="data" />
          <add segment="logs" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
