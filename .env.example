# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
# Hosts that run Node behind IIS assign HTTP_PLATFORM_PORT and usually map it
# to PORT. The server accepts either, so PORT can stay unset there.
PORT=4000
APP_NAME=DonutSpin
# Public origin used in every email link and for secure cookies. In production
# a missing or loopback value falls back to https://donutspin.runasp.net, so a
# development .env cannot send localhost links to real users.
APP_URL=http://localhost:5173

# Persistent data. Leave DATABASE_PATH unset in production: the server detects
# an existing app.db, data/app.db, data/aurum.db, or App_Data database and never
# creates a new empty one silently. New installations default to
# App_Data/aurum.db. Relative paths resolve from the application root.
# DATABASE_PATH=./App_Data/aurum.db
# Optional directory for backups, the generated session secret, and generated
# owner credentials. Defaults to App_Data/.
# DONUTSPIN_DATA_DIR=./App_Data

# Set DB_BACKUP_BEFORE_MIGRATION=false only after taking a manual backup.
DB_BACKUP_BEFORE_MIGRATION=true
DB_BACKUP_KEEP=10

# Production refuses to boot if it would create a brand-new empty database.
# Set this to true once only for a genuinely new installation, then remove it.
# ALLOW_NEW_DATABASE=false

# 64+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SESSION_SECRET=
SESSION_DAYS=7

# DonutSMP money granted once to a new account
STARTING_CREDITS=5000000

# Set to true only for local testing: exposes password-reset links in the API response
EXPOSE_RESET_TOKEN=false

# Optional transactional email (Brevo relay defaults preconfigured in the admin panel).
# Prefer saving the SMTP key in Admin -> Email; this file is only a fallback.
# Leave SMTP_PASS blank to keep delivery disabled until an owner configures it.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=
SMTP_FROM=DonutSpin <no-reply@example.com>

# Optional stable key for encrypting the SMTP key saved from the admin panel.
# Defaults to SESSION_SECRET. Changing it invalidates a previously saved SMTP key.
EMAIL_ENCRYPTION_KEY=

# Cloudflare Turnstile bot protection. The site key is public; the secret key
# must only be set in the hosting panel or a local .env, never committed.
# Leave TURNSTILE_SITE_KEY blank to use the built-in public site key.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set to false to disable the widget and server checks without removing keys.
TURNSTILE_ENABLED=true
# Optional extra check; Cloudflare already restricts widget hostnames.
# TURNSTILE_EXPECTED_HOSTNAME=donutspin.runasp.net

# Bootstrap / recover an owner account on a hosted deployment. These are read at
# startup. Leave them unset in development and use `npm run owner` instead.
# OWNER_EMAIL=you@example.com
# OWNER_USERNAME=owner
# OWNER_PASSWORD=
# Set to true to overwrite the password of the OWNER_EMAIL account on boot.
# OWNER_RESET_PASSWORD=false

# Forwarded headers are ignored unless this is true. IIS forwards a
# client-supplied X-Forwarded-For untouched, so only enable this after the proxy
# is configured to overwrite it (see README "Client IPs behind IIS").
TRUST_PROXY_HEADERS=false
# Additional trusted proxy addresses besides loopback, comma separated.
TRUSTED_PROXY_IPS=
# Session cookies are Secure when APP_URL is https. Uncomment to force a value.
# COOKIE_SECURE=false

# ── Discord bot ─────────────────────────────────────────────────────────────
# The bot runs on its own host and reaches this website only through the
# authenticated /api/bot API. Generate 32+ random characters and use the exact
# same value in DonutSpin-bot/.env as DONUTSPIN_BOT_API_KEY.
# Leave blank to disable the bot API entirely.
DISCORD_BOT_API_KEY=
