# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
# Hosts that run Node behind IIS assign HTTP_PLATFORM_PORT and usually map it
# to PORT. The server accepts either, so PORT can stay unset there.
PORT=4000
APP_NAME=Donutcash
# Public origin. Set this to the real domain in production so mutation
# requests are pinned to it; when unset, same-origin requests are trusted.
APP_URL=http://localhost:5173
DATABASE_PATH=./data/aurum.db

# 64+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SESSION_SECRET=
SESSION_DAYS=7

# DonutSMP money granted once to a new account
STARTING_CREDITS=5000000


# Set to true only for local testing: exposes password-reset links in the API response
EXPOSE_RESET_TOKEN=false

# Optional transactional email (Brevo relay defaults preconfigured in the admin panel).
# Prefer saving the SMTP key in Admin -> Email; this file is only a fallback.
# Leave SMTP_PASS blank to keep delivery disabled until an owner configures it.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=c05ccf001@smtp-brevo.com
SMTP_PASS=
SMTP_FROM=Donutcash <no-reply@example.com>

# Optional stable key for encrypting the SMTP key saved from the admin panel.
# Defaults to SESSION_SECRET. Changing it invalidates a previously saved SMTP key.
EMAIL_ENCRYPTION_KEY=

# Bootstrap / recover an owner account on a hosted deployment. These are read at
# startup. Leave them unset in development and use `npm run owner` instead.
# OWNER_EMAIL=you@example.com
# OWNER_USERNAME=owner
# OWNER_PASSWORD=
# Set to true to overwrite the password of the OWNER_EMAIL account on boot.
# OWNER_RESET_PASSWORD=false
