# Dependencies
node_modules/

# Live IIS configuration: MonsterASP generates it on every Build & publish.
# Keep deploy/web.config.example tracked instead.
web.config

# Persistent runtime data. App_Data is the default data root and is preserved
# by MonsterASP publishes; data/ remains supported for existing installations.
# Never commit databases, WAL sidecars, secrets, generated credentials or
# backups.
App_Data/
app_data/
data/
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
.session-secret
owner-credentials.txt
backups/

# Secrets and local environment
.env
.env.*
!.env.example

# The Discord bot is a separate Git repository rooted at DonutSpin-bot/. It is
# deployed on its own host and must not be included when this website is
# pushed. Keep the trailing slash so only the directory is ignored.
DonutSpin-bot/

# Generated build output: rebuilt by `npm run build` on the host
dist/
build/

# User uploads (none today; keep future uploads out of Git)
uploads/

# Logs and local tooling output
*.log
logs/
coverage/
.DS_Store
