<?xml version="1.0" encoding="utf-8"?>
<!--
  TEMPLATE ONLY. Do not commit a file named web.config.

  MonsterASP's "Node.js SSR app" deployment generates /wwwroot/web.config on
  every Build & publish, using the Start command and panel environment
  variables. A tracked web.config gets locally modified by that generator and
  is the root cause of:

    "Pull failed because local changes in the deployed files conflict with
     the repository."

  Copy this file to web.config only for a manual IIS/Plesk deployment where the
  panel does not generate one. On MonsterASP, leave web.config alone and set
  APP_URL, SESSION_SECRET, TURNSTILE_SECRET_KEY, and other values under
  Websites -> Environment variables.

  HTTP_PLATFORM_PORT is assigned by IIS. The app reads it directly, so the
  mapping to PORT below is only a convenience for older builds.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>

    <httpPlatform processPath="node"
                  arguments="server.js"
                  startupTimeLimit="120"
                  startupRetryCount="10"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <!--
          Public origin used for every link in outgoing email (verification,
          password reset, lobby). Change this when the domain changes; a panel
          environment variable with the same name overrides it.
        -->
        <environmentVariable name="APP_URL" value="https://donutcash.runasp.net" />
      </environmentVariables>
    </httpPlatform>

    <!--
      Defence in depth for manual IIS deployments. MonsterASP's generated
      configuration may not contain these entries, but every request still
      reaches Express, whose SPA fallback refuses the same private paths.
    -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="server" />
          <add segment="build" />
          <add segment="shared" />
          <add segment="src" />
          <add segment="tests" />
          <add segment="data" />
          <add segment="App_Data" />
          <add segment="logs" />
          <add segment=".git" />
          <add segment="app.db" />
          <add segment="app.db-wal" />
          <add segment="app.db-shm" />
          <add segment=".session-secret" />
          <add segment="owner-credentials.txt" />
          <add segment=".env" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
